{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "hmpo-footer/macro.njk" import hmpoFooter %}
{% from "components/protected-message-editor.njk" import protectedMessageEditor %}
<!doctype html><html lang="en" class="govuk-template"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Edit notification message – HM Passport Office</title><link rel="stylesheet" href="/styles.css"></head>
<body class="govuk-template__body"><script>document.body.className += ' js-enabled';</script>{{ govukSkipLink({ href: '#main-content', text: 'Skip to main content' }) }}{{ govukHeader({ homepageUrl: 'https://www.gov.uk/', serviceName: 'Passport automation', serviceUrl: '/', useTudorCrown: true }) }}
<main class="govuk-main-wrapper" id="main-content"><div class="govuk-width-container"><div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds"><h1 class="govuk-heading-xl">Edit notification message</h1><p class="govuk-body">You can edit the notification message. Protected values are highlighted in red and cannot be changed.</p>
<form method="post" action="/edit-notification"><input type="hidden" name="editorToken" value="{{ editorToken }}">{{ protectedMessageEditor({ id: 'message', name: 'message', label: 'Notification message', hint: 'Protected values are read-only. You can select and copy them.', value: message, protectedRanges: protectedRanges, errorMessage: errorMessage }) }}{{ govukButton({ text: 'Continue' }) }}</form>
{% if submittedMessage %}<div class="govuk-notification-banner govuk-notification-banner--success" role="region" aria-labelledby="success-title"><div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="success-title">Message saved</h2></div><div class="govuk-notification-banner__content"><p class="govuk-body">The complete message was submitted as one value.</p></div></div>{% endif %}
</div></div></div></main>{{ hmpoFooter({ organisationLogo: true }) }}<script type="module">import { initialiseProtectedMessageEditors } from '/protected-message-editor.js'; initialiseProtectedMessageEditors();</script></body></html>
