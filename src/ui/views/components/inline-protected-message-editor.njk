{% macro inlineProtectedMessageEditor(params) %}
<div class="govuk-form-group{% if params.errorMessage %} govuk-form-group--error{% endif %}">
  <label class="govuk-label govuk-label--m" for="{{ params.id }}-value">{{ params.label }}</label>
  {% if params.hint %}<div id="{{ params.id }}-hint" class="govuk-hint">{{ params.hint }}</div>{% endif %}
  {% if params.errorMessage %}<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ params.errorMessage }}</p>{% endif %}
  <div class="inline-message-editor" id="{{ params.id }}" data-inline-protected-message-editor data-name="{{ params.name }}" data-protected-ranges="{{ params.protectedRanges | dump }}">
    <textarea data-inline-message-source hidden>{{ params.message }}</textarea>
    <textarea id="{{ params.id }}-value" name="{{ params.name }}" data-inline-message-value hidden></textarea>
    <span class="inline-message-editor__measure" data-inline-message-measure aria-hidden="true"></span>
    <div class="inline-message-editor__document" data-inline-message-document></div>
  </div>
</div>
{% endmacro %}
