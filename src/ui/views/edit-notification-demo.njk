{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "hmpo-footer/macro.njk" import hmpoFooter %}
{% from "components/inline-protected-message-editor.njk" import inlineProtectedMessageEditor %}
<!doctype html><html lang="en" class="govuk-template"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Edit notification message – HM Passport Office</title><link rel="stylesheet" href="/styles.css"></head><body class="govuk-template__body"><script>document.body.className += ' js-enabled';</script>{{ govukSkipLink({ href: '#main-content', text: 'Skip to main content' }) }}{{ govukHeader({ homepageUrl: 'https://www.gov.uk/', serviceName: 'Passport automation', serviceUrl: '/', useTudorCrown: true }) }}<main class="govuk-main-wrapper" id="main-content"><div class="govuk-width-container"><div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds"><h1 class="govuk-heading-xl">Edit notification message</h1><form method="post" action="/edit-notification-demo"><input type="hidden" name="editorToken" value="{{ editorToken }}">{{ inlineProtectedMessageEditor({ id: 'notification-editor', name: 'message', label: 'Notification message', hint: 'Protected values are shown in red and cannot be changed.', message: message, protectedRanges: protectedRanges, errorMessage: errorMessage }) }}{{ govukButton({ text: 'Continue' }) }}</form>{% if submittedMessage %}<h2 class="govuk-heading-m">Submitted message</h2><pre class="inline-message-preview">{{ submittedMessage }}</pre>{% endif %}</div></div></div></main>{{ hmpoFooter({ organisationLogo: true }) }}<script type="module">import { initialiseInlineProtectedMessageEditors } from '/inline-protected-message-editor.js'; initialiseInlineProtectedMessageEditors();</script></body></html>
