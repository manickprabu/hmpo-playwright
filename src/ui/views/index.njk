{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}
{% from "hmpo-inset-text/macro.njk" import hmpoInsetText %}
{% from "hmpo-footer/macro.njk" import hmpoFooter %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "components/inline-protected-message-editor.njk" import inlineProtectedMessageEditor %}
{% from "components/protected-message-editor.njk" import protectedMessageEditor %}
<!doctype html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Passport automation – HM Passport Office</title>
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/assets/images/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="govuk-template__body">
    <script>document.body.className += ' js-enabled';</script>
    {{ govukSkipLink({ href: '#main-content', text: 'Skip to main content' }) }}
    {{ govukHeader({ homepageUrl: 'https://www.gov.uk/', serviceName: 'Passport automation', serviceUrl: '/', useTudorCrown: true }) }}
    <main class="govuk-main-wrapper" id="main-content">
      <div class="govuk-width-container">
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-xl">Passport automation activity</h1>
            {{ hmpoInsetText({ text: 'This local dashboard refreshes automatically while a batch runs. Passport numbers are masked.' }) }}
          </div>
        </div>

        <div class="dashboard-layout">
          <nav class="dashboard-navigation" aria-label="Dashboard sections" role="tablist">
            <button class="dashboard-navigation__item is-active" type="button" role="tab" aria-selected="true" aria-controls="automation-panel" data-panel-target="automation-panel">Automation</button>
            <button class="dashboard-navigation__item" type="button" role="tab" aria-selected="false" aria-controls="activity-panel" data-panel-target="activity-panel">Activity</button>
          </nav>
          <div class="dashboard-content">
            <section id="automation-panel" role="tabpanel">
              {% include "partials/automation-controls.njk" %}
              {% include "partials/passport-management.njk" %}
              <section class="dashboard-panel" aria-labelledby="notification-editor-heading">
                <h2 class="govuk-heading-m" id="notification-editor-heading">Edit notification message</h2>
                <p class="govuk-body">Protected values are highlighted in red and cannot be changed.</p>
                <form method="post" action="/edit-notification-demo" data-message-editor-form data-editor-kind="inline">
                  <input type="hidden" name="editorToken" value="{{ editorToken }}" />
                  {{ inlineProtectedMessageEditor({
                    id: 'dashboard-message',
                    name: 'message',
                    label: 'Notification message',
                    hint: 'Protected values are read-only and shown in red. You can select and copy them.',
                    message: message,
                    protectedRanges: protectedRanges
                  }) }}
                  {{ govukButton({ text: 'Save notification message' }) }}
                </form>
              </section>
              <section class="dashboard-panel" aria-labelledby="textarea-notification-editor-heading">
                <h2 class="govuk-heading-m" id="textarea-notification-editor-heading">Textarea protected message editor</h2>
                <p class="govuk-body">This native textarea version highlights the same protected values in red.</p>
                <form method="post" action="/edit-notification" data-message-editor-form data-editor-kind="textarea">
                  <input type="hidden" name="editorToken" value="{{ editorToken }}" />
                  {{ protectedMessageEditor({
                    id: 'dashboard-message-textarea',
                    name: 'message',
                    label: 'Notification message',
                    hint: 'Protected values are read-only. You can select and copy them.',
                    value: message,
                    protectedRanges: protectedRanges
                  }) }}
                  {{ govukButton({ text: 'Save textarea notification message' }) }}
                </form>
              </section>
            </section>
            <section id="activity-panel" role="tabpanel" hidden>{% include "partials/run-summary.njk" %}</section>
          </div>
        </div>
        <p class="govuk-hint">Screenshots and extracted text remain in the local output folder.</p>
      </div>
    </main>
    {{ hmpoFooter({ organisationLogo: true }) }}
    <script type="module" src="/app.js"></script>
  </body>
</html>
