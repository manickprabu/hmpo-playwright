{
  "name": "passport-browser-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Sequential, session-isolated passport workflow automation with Playwright.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:ui",
    "start": "node dist/index.js",
    "ui": "npm run build && tsx src/ui/server.ts",
    "ui:start": "node dist/ui/server.js",
    "copy:ui": "mkdir -p dist/ui/public && cp src/ui/public/*.js dist/ui/public/ && cp -R node_modules/govuk-frontend/dist/govuk/assets dist/ui/public/assets && sass --quiet-deps --silence-deprecation=import --load-path=node_modules src/ui/styles.scss dist/ui/public/styles.css",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"src/ui/public/*.{html,css,js}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/ui/public/*.{html,css,js}\" \"*.{json,md,yml,yaml}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^16.6.1",
    "govuk-frontend": "^5.14.0",
    "hmpo-components": "^8.0.6",
    "nunjucks": "^3.2.4",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.15.30",
    "@types/nunjucks": "^3.2.6",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
