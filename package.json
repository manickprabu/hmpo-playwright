{
  "name": "passport-browser-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Sequential, session-isolated passport workflow automation with Playwright.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,yml,yaml}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prettier": "^3.9.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
