# Required: the login/search page URL. Do not commit a real .env file.
TARGET_URL=https://www.costco.co.uk/

# Optional site credentials used before the passport search step.
USERNAME=
PASSWORD=
USERNAME_SELECTOR=
PASSWORD_SELECTOR=
LOGIN_BUTTON_SELECTOR=

# Browser execution
HEADLESS=true
SLOW_MO=0
NAVIGATION_TIMEOUT=30000
SCREENSHOT_QUALITY=90
OUTPUT_DIR=output

# Optional. Use an absolute or project-relative input path.
INPUT_FILE=input/passports.txt

# Optional local dashboard port
UI_PORT=4174
